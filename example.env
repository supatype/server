# Only for HTTPS Hooks
SUPATYPE_HOOK_CUSTOM_SMS_PROVIDER_SECRET=""


# Test OTP Config
SUPATYPE_SMS_TEST_OTP="<phone-1>:<otp-1>, <phone-2>:<otp-2>..."
SUPATYPE_SMS_TEST_OTP_VALID_UNTIL="<ISO date time>" # (e.g. 2023-09-29T08:14:06Z)

SUPATYPE_MFA_WEB_AUTHN_ENROLL_ENABLED="false"
SUPATYPE_MFA_WEB_AUTHN_VERIFY_ENABLED="false"
