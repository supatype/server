SUPATYPE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED="false"
SUPATYPE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL="0"
SUPATYPE_SECURITY_UPDATE_PASSWORD_REQUIRE_REAUTHENTICATION="false"
SUPATYPE_OPERATOR_TOKEN="unused-operator-token"
SUPATYPE_RATE_LIMIT_HEADER="X-Forwarded-For"
SUPATYPE_RATE_LIMIT_EMAIL_SENT="100"

SUPATYPE_MAX_VERIFIED_FACTORS=10

# Auth Hook Configuration
SUPATYPE_HOOK_CUSTOM_ACCESS_TOKEN_ENABLED=false
SUPATYPE_HOOK_CUSTOM_ACCESS_TOKEN_URI=""
