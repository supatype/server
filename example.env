# General Config
# NOTE: The service_role key is required as an authorization header for /admin endpoints

SUPATYPE_JWT_SECRET="CHANGE-THIS! VERY IMPORTANT!"
SUPATYPE_JWT_EXP="3600"
SUPATYPE_JWT_AUD="authenticated"
SUPATYPE_JWT_DEFAULT_GROUP_NAME="authenticated"
SUPATYPE_JWT_ADMIN_ROLES="supatype_admin,service_role"

# Database & API connection details
SUPATYPE_DB_DRIVER="postgres"
SUPATYPE_DB_NAMESPACE="auth"
DATABASE_URL="postgres://supatype_auth_admin:root@localhost:5432/postgres"
SUPATYPE_API_EXTERNAL_URL="http://localhost:9999"
SUPATYPE_API_HOST="localhost"
PORT="9999"

# SMTP config (generate credentials for signup to work)
SUPATYPE_SMTP_HOST=""
SUPATYPE_SMTP_PORT=""
SUPATYPE_SMTP_USER=""
SUPATYPE_SMTP_MAX_FREQUENCY="5s"
SUPATYPE_SMTP_PASS=""
SUPATYPE_SMTP_ADMIN_EMAIL=""
SUPATYPE_SMTP_SENDER_NAME=""

# Optional: send-email HTTP hook — The auth service POSTs signed payloads to this URI; supatype-server
# implements POST /internal/v0hooks/send-email (or use an HTTPS Edge URL). See Phase 10.6 A24.
# SUPATYPE_HOOK_SEND_EMAIL_ENABLED="true"
# SUPATYPE_HOOK_SEND_EMAIL_URI="http://127.0.0.1:9999/internal/v0hooks/send-email"
# SUPATYPE_HOOK_SEND_EMAIL_SECRETS="v1,whsec_your_symmetric_secret_here"

# Mailer config
SUPATYPE_MAILER_AUTOCONFIRM="true"
SUPATYPE_MAILER_URLPATHS_CONFIRMATION="/verify"
SUPATYPE_MAILER_URLPATHS_INVITE="/verify"
SUPATYPE_MAILER_URLPATHS_RECOVERY="/verify"
SUPATYPE_MAILER_URLPATHS_EMAIL_CHANGE="/verify"
SUPATYPE_MAILER_SUBJECTS_CONFIRMATION="Confirm Your Email"
SUPATYPE_MAILER_SUBJECTS_RECOVERY="Reset Your Password"
SUPATYPE_MAILER_SUBJECTS_MAGIC_LINK="Your Magic Link"
SUPATYPE_MAILER_SUBJECTS_EMAIL_CHANGE="Confirm Email Change"
SUPATYPE_MAILER_SUBJECTS_INVITE="You have been invited"
SUPATYPE_MAILER_SUBJECTS_PASSWORD_CHANGED_NOTIFICATION="Your password has been changed"
SUPATYPE_MAILER_SUBJECTS_EMAIL_CHANGED_NOTIFICATION="Your email address has been changed"
SUPATYPE_MAILER_SUBJECTS_PHONE_CHANGED_NOTIFICATION="Your phone number has been changed"
SUPATYPE_MAILER_SUBJECTS_IDENTITY_LINKED_NOTIFICATION="A new identity has been linked"
SUPATYPE_MAILER_SUBJECTS_IDENTITY_UNLINKED_NOTIFICATION="An identity has been unlinked"
SUPATYPE_MAILER_SUBJECTS_MFA_FACTOR_ENROLLED_NOTIFICATION="A new MFA factor has been enrolled"
SUPATYPE_MAILER_SUBJECTS_MFA_FACTOR_UNENROLLED_NOTIFICATION="An MFA factor has been unenrolled"
SUPATYPE_MAILER_SECURE_EMAIL_CHANGE_ENABLED="true"

# Custom mailer template config
SUPATYPE_MAILER_TEMPLATES_INVITE=""
SUPATYPE_MAILER_TEMPLATES_CONFIRMATION=""
SUPATYPE_MAILER_TEMPLATES_RECOVERY=""
SUPATYPE_MAILER_TEMPLATES_MAGIC_LINK=""
SUPATYPE_MAILER_TEMPLATES_EMAIL_CHANGE=""
SUPATYPE_MAILER_TEMPLATES_PASSWORD_CHANGED_NOTIFICATION=""
SUPATYPE_MAILER_TEMPLATES_EMAIL_CHANGED_NOTIFICATION=""
SUPATYPE_MAILER_TEMPLATES_PHONE_CHANGED_NOTIFICATION=""
SUPATYPE_MAILER_TEMPLATES_IDENTITY_LINKED_NOTIFICATION=""
SUPATYPE_MAILER_TEMPLATES_IDENTITY_UNLINKED_NOTIFICATION=""
SUPATYPE_MAILER_TEMPLATES_MFA_FACTOR_ENROLLED_NOTIFICATION=""
SUPATYPE_MAILER_TEMPLATES_MFA_FACTOR_UNENROLLED_NOTIFICATION=""

# Account changes notifications configuration
SUPATYPE_MAILER_NOTIFICATIONS_PASSWORD_CHANGED_ENABLED="false"
SUPATYPE_MAILER_NOTIFICATIONS_EMAIL_CHANGED_ENABLED="false"
SUPATYPE_MAILER_NOTIFICATIONS_PHONE_CHANGED_ENABLED="false"
SUPATYPE_MAILER_NOTIFICATIONS_IDENTITY_LINKED_ENABLED="false"
SUPATYPE_MAILER_NOTIFICATIONS_IDENTITY_UNLINKED_ENABLED="false"
SUPATYPE_MAILER_NOTIFICATIONS_MFA_FACTOR_ENROLLED_ENABLED="false"
SUPATYPE_MAILER_NOTIFICATIONS_MFA_FACTOR_UNENROLLED_ENABLED="false"

# Signup config
SUPATYPE_DISABLE_SIGNUP="false"
SUPATYPE_SITE_URL="http://localhost:3000"
SUPATYPE_EXTERNAL_EMAIL_ENABLED="true"
SUPATYPE_EXTERNAL_PHONE_ENABLED="true"
SUPATYPE_EXTERNAL_IOS_BUNDLE_ID="com.supatype.auth"

# Whitelist redirect to URLs here, a comma separated list of URIs (e.g. "https://foo.example.com,https://*.foo.example.com,https://bar.example.com")
SUPATYPE_URI_ALLOW_LIST="http://localhost:3000"

