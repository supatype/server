SUPATYPE_JWT_SECRET=testsecret
SUPATYPE_JWT_EXP=3600
SUPATYPE_JWT_AUD="authenticated"
SUPATYPE_JWT_ADMIN_ROLES="supatype_admin,service_role"
SUPATYPE_JWT_DEFAULT_GROUP_NAME="authenticated"
SUPATYPE_DB_DRIVER=postgres
SUPATYPE_DB_NAMESPACE="auth"
SUPATYPE_DB_AUTOMIGRATE=true
DATABASE_URL="postgres://supatype_auth_admin:root@localhost:5432/postgres"
SUPATYPE_API_HOST=localhost
PORT=9999
SUPATYPE_API_EXTERNAL_URL="http://localhost:9999"
SUPATYPE_LOG_SQL=none
SUPATYPE_LOG_LEVEL=warn
SUPATYPE_SITE_URL=https://example.netlify.com
# The allow list names a domain this project does not own, deliberately. The
# Web3 sign-in tests verify real Ed25519 and secp256k1 signatures, and the
# domain is inside the signed payload, so it cannot be renamed without the
# wallet keys that produced them. Change it and TestWeb3 fails with
# "Signature does not match address in message".
SUPATYPE_URI_ALLOW_LIST="http://localhost:3000,https://supabase.com/,http://localhost:5173/"
SUPATYPE_OPERATOR_TOKEN=foobar
